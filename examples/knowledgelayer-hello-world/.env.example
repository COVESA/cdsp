# Template for the .env of this example, used by docker-compose.yml.
#
# Copy it and adjust the values:
#   cp .env.example .env
#
# .env is not tracked in git: put your Remotive Labs broker URL and API key there, never in this file.
# All variables are described in README.md (this folder).

######################
# REMOTIVE LABS      #
######################

# Broker URL and API key from your Remotive Labs account, see README.md
REMOTIVE_LABS_BROKER_URL=
REMOTIVE_LABS_BROKER_API_KEY=

######################
# RDFOX LICENCE      #
######################

# Only used by the rdfox profile, but Docker Compose needs the variable to read the compose file.
RDFOX_LIC_PATH="../shared-config/rdfox/RDFox.lic"

#########################################
# INFORMATION LAYER (IoTDB)             #
#########################################
# HANDLER_TYPE and IOTDB_POLL_INTERVAL_LEN_IN_SEC are set in docker-compose.yml.

IOTDB_HOST="iotdb-service"
IOTDB_PORT=6667
IOTDB_USER="root"
IOTDB_PASSWORD="root"
IOTDB_FETCH_SIZE=10000

#########################################
# KNOWLEDGE LAYER                       #
#########################################
# HOST_REASONER_SERVER is set per profile in docker-compose.yml.

VEHICLE_OBJECT_ID="VINABCD1234567890"
HOST_WEBSOCKET_SERVER="information-layer"
PORT_WEBSOCKET_SERVER="8080"
PORT_REASONER_SERVER="12110"
# Base64 of root:admin, the RDFox development credentials configured in docker/docker-compose-cdsp.yml
AUTH_REASONER_SERVER_BASE64="cm9vdDphZG1pbg=="
REASONER_DATASTORE_NAME="ds-test"
# The KL-config/<reasoner>_model folder of the profile is mounted here
MODEL_CONFIGURATION_PATH="/symbolic-reasoner/examples/use-case/model/"
