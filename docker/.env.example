# Template for docker/.env, used by docker-compose-cdsp.yml.
#
# Copy it and adjust the values to your setup:
#   cp .env.example .env
#
# docker/.env is not tracked in git: keep your own values and any secrets there, never in this file.
# All variables are described in README.md (this folder).

######################
# RDFOX LICENCE      #
######################

# Only used by the rdfox profile, but Docker Compose needs the variable to read the compose file.
RDFOX_LIC_PATH="../examples/shared-config/rdfox/RDFox.lic"

#########################################
# INFORMATION LAYER (IoTDB)             #
#########################################

HANDLER_TYPE=iotdb
IOTDB_HOST="iotdb-service"
IOTDB_PORT=6667
IOTDB_USER="root"
IOTDB_PASSWORD="root"
IOTDB_FETCH_SIZE=10000
IOTDB_POLL_INTERVAL_LEN_IN_SEC=0.2

#########################################
# KNOWLEDGE LAYER                       #
#########################################
# HOST_REASONER_SERVER and MODEL_CONFIGURATION_PATH are set per profile in docker-compose-cdsp.yml.

VEHICLE_OBJECT_ID="VINABCD1234567890"
HOST_WEBSOCKET_SERVER="information-layer"
PORT_WEBSOCKET_SERVER="8080"
PORT_REASONER_SERVER="12110"
# Base64 of root:admin, the RDFox development credentials configured in docker-compose-cdsp.yml
AUTH_REASONER_SERVER_BASE64="cm9vdDphZG1pbg=="
REASONER_DATASTORE_NAME="ds-test"
